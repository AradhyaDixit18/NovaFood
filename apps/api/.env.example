# Copy to apps/api/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000
# Browser origins allowed to call the API (comma-separated). The first is used in email links.
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info
# Number of proxies in front of the app. 1 on Render, Railway, Fly.
TRUST_PROXY=0
# Path to the built web app. When set, the API also serves the website on the same origin.
# WEB_DIST_DIR=../web/dist

# MongoDB Atlas or local. Percent-encode special characters in the password (@ -> %40).
MONGODB_URI=mongodb://127.0.0.1:27017/novafood

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (HTTPS).
COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=false

# console (prints emails to the terminal) or resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=NovaFood <onboarding@resend.dev>

# Image uploads. Leave empty to disable uploads (dishes fall back to illustrated art).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay TEST keys (Dashboard > Test mode > API keys). Leave empty to offer cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seeding: fixes the admin demo password instead of generating one.
# SEED_ADMIN_PASSWORD=
